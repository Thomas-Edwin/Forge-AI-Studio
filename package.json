{
  "name": "forgeai-studio",
  "version": "1.0.0",
  "private": true,
  "description": "ForgeAI Studio — autonomous multi-agent software engineering platform (monorepo orchestration)",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "dev:web": "bash scripts/dev-web.sh",
    "dev:api": "bash scripts/dev-api.sh",
    "dev:windows": "start \"ForgeAI API\" cmd /k npm run dev:api:windows && start \"ForgeAI Web\" cmd /k npm run dev:web:windows",
    "dev:web:windows": "cd frontend && npm run dev",
    "dev:api:windows": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build:web": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "format": "npm run format --prefix frontend",
    "test": "bash scripts/test.sh",
    "health": "bash scripts/healthcheck.sh"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
