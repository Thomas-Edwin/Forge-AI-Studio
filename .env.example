# ForgeAI Studio — Root environment template (Vercel single-project deployment)
#
# For Vercel: set the PRODUCTION column values in the Vercel dashboard
# (Project → Settings → Environment Variables). These are the SAME variables
# documented in frontend/.env.example and backend/.env.example — duplicated
# here as the single-project deployment checklist. Never commit real secrets.

# --- Frontend (build-time, Next.js) ---
# Leave EMPTY in production: the Vercel project serves the API same-origin
# under /api (repository-root vercel.json). Do not set a cross-origin URL.
NEXT_PUBLIC_API_URL=

# WebSocket / SSE endpoint (Phase 3.2+). Leave empty in production.
NEXT_PUBLIC_WS_URL=

# Production: the deployed site URL, e.g. https://<project>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Refresh-token cookie name (backend convention)
NEXT_PUBLIC_AUTH_COOKIE=forgeai_refresh

# --- Backend (runtime, FastAPI function) ---
# development | staging | production
APP_ENV=production

# Same-origin /api deployment: localhost only needed for local dev.
CORS_ORIGINS=["http://localhost:3000"]

# Managed Postgres (Vercel has no persistent disk):
# postgresql+asyncpg://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

# Managed Redis, or empty to disable Redis-backed features safely.
REDIS_URL=

# Rotate in production (32+ random bytes). NEVER commit the real value.
SECRET_KEY=

# Optional: LLM API key (empty = deterministic agent engine).
LLM_API_KEY=

# Password-reset links / emails point here. Production: your deployed URL.
APP_PUBLIC_URL=http://localhost:3000

# LOG_FILE must stay empty on Vercel (read-only /var/task filesystem).
LOG_FILE=
