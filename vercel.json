{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": "backend/app/**"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/index.py" },
    { "src": "/healthz", "dest": "backend/index.py" },
    { "src": "/readyz", "dest": "backend/index.py" },
    { "src": "/(.*)", "dest": "frontend/package.json" }
  ]
}
